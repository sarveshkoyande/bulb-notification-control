<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/enableListenerBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_listener"
        android:layout_marginBottom="12dp" />

    <!-- ===== Bulb control card ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#eef0f4"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bulb Control"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/modeWhiteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="White" />

            <Button
                android:id="@+id/modeColourBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Colour" />

            <Button
                android:id="@+id/powerToggleBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="On/Off" />
        </LinearLayout>

        <View
            android:id="@+id/colorPreview"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:background="#ffffff" />

        <!-- Colour mode controls -->
        <LinearLayout
            android:id="@+id/colourControlsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/hueLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hue: 0" />
            <SeekBar
                android:id="@+id/hueSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="360" />

            <TextView
                android:id="@+id/satLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saturation: 1000" />
            <SeekBar
                android:id="@+id/satSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="1000" />

            <TextView
                android:id="@+id/valLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brightness: 1000" />
            <SeekBar
                android:id="@+id/valSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="1000" />
        </LinearLayout>

        <!-- White mode controls -->
        <LinearLayout
            android:id="@+id/whiteControlsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/brightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brightness: 1000" />
            <SeekBar
                android:id="@+id/brightSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="990"
                android:progress="990" />

            <TextView
                android:id="@+id/tempLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warmth (0=warm, 1000=cool): 500" />
            <SeekBar
                android:id="@+id/tempSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="500" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Advanced / Pairing / Debug:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="8dp"
        android:background="#f0f0f0">

        <LinearLayout
            android:id="@+id/testButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Logs:"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggleLogBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minimize" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="Waiting for events..."
            android:fontFamily="monospace"
            android:padding="8dp" />

    </ScrollView>

</LinearLayout>
